<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests (xUnit v3 on Microsoft.Testing.Platform): fake clock, fake hardware, real-device classifier fixtures. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>RogBacklightTimeout.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="RogBacklightTimeout.Core" />
    <Using Include="RogBacklightTimeout.Diagnostics" />
    <Using Include="RogBacklightTimeout.Input" />
    <Using Include="RogBacklightTimeout.Installation" />
    <Using Include="RogBacklightTimeout.Integrations" />
    <Using Include="RogBacklightTimeout.Platform" />
    <Using Include="RogBacklightTimeout.Rog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RogBacklightTimeout.Core\RogBacklightTimeout.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one executable: opens the menu when started normally and runs the background agent when given the agent argument.
    A GUI-subsystem program so the agent never flashes a console window; the menu opens its own console.
    Published self-contained, single file and trimmed, so it runs by double-click with nothing to install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RogBacklightTimeout</AssemblyName>
    <RootNamespace>RogBacklightTimeout</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- HidSharp is third-party and uses reflection internally: keep it whole and do not fail the build on its trim notice. -->
    <WarningsNotAsErrors>IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="HidSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RogBacklightTimeout.Core\RogBacklightTimeout.Core.csproj" />
  </ItemGroup>

</Project>
